package jian.runtime

/**
 * Subcommand adapter generated by `@Command`.
 */
public interface Command {
    /**
     * CLI name, e.g. `sync-all`.
     */
    prop name: String

    /**
     * Help and usage metadata.
     */
    prop spec: CommandSpec

    /**
     * Parses arguments, invokes the command and returns its exit code.
     *
     * throws UsageException on a malformed command line.
     */
    func run(args: ArgCursor): Int64
}

/**
 * App-level adapter generated by `@Callback`.
 */
public interface Callback {
    /**
     * Help and usage metadata.
     */
    prop spec: CommandSpec

    /**
     * Parses app options up to the subcommand, leaving it and its arguments in `args`.
     * Invokes the callback and returns its exit code.
     *
     * throws UsageException on a malformed command line.
     */
    func run(args: ArgCursor): Int64
}
