package jian.runtime

/**
 * Subcommand adapter generated by `@JianCommand`.
 */
public interface JianCommand {
    /**
     * CLI name, e.g. `sync-all`.
     */
    prop name: String

    /**
     * Help and usage metadata.
     */
    prop spec: JianCommandSpec

    /**
     * Parses arguments, invokes the command and returns its exit code.
     *
     * throws JianUsageException on a malformed command line.
     */
    func run(args: JianArgCursor): Int64
}

/**
 * App-level adapter generated by `@JianCallback`.
 */
public interface JianCallback {
    /**
     * Help and usage metadata.
     */
    prop spec: JianCommandSpec

    /**
     * Parses app options up to the subcommand, leaving it and its arguments in `args`.
     * Invokes the callback and returns its exit code.
     *
     * throws JianUsageException on a malformed command line.
     */
    func run(args: JianArgCursor): Int64
}
